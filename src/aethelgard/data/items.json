{
 "_comment": "Bases, affixes and drop rules. An affix only rolls on item types listed in its slots (no attack speed on body armor, no movement speed on a weapon); tags are kept for older rules. guardEfficiency (shields) reduces the Energy spent per block; blockReduction (shields) adds to the share of a blocked hit the guard stops (balance.json guard). level = minimum item level (iLvl) for the base/affix to appear. size = inventory cells [width, height]. inventory = backpack grid (columns × rows); for now it limits how many items the character carries. startingGear = bases a new character wears. rareNames = parts of rare item names: '<first> <second>'.",
 "inventory": {
  "columns": 10,
  "rows": 6
 },
 "startingGear": ["short_sword", "buckler", "leather_armor"],
 "trade": {
  "_comment": "Vendor prices. Item price = (basePrice + perItemLevel x iLvl + perAffix x affixes) x rarityMult[rarity]; the vendor pays sellFraction of that. The stock (stockSize items, normal and magic only, iLvl = character level) is rolled again every time you come to town. Consumables cost their own 'price'. npcRangeTiles = how close you must stand to trade or use the stash.",
  "basePrice": 20,
  "perItemLevel": 6,
  "perAffix": 25,
  "rarityMult": [1, 3, 8, 20],
  "sellFraction": 0.2,
  "stockSize": 18,
  "npcRangeTiles": 3.0
 },
 "consumables": {
  "_comment": "Used from the HUD keys (ui/keys.json). restore = life | energy, pctOfMax of the maximum given over 'seconds' (several potions stack). cooldownSeconds = time before the same kind can be used again. portal = opens a town portal where you stand; walking into it takes you to town, and the portal in town brings you back (the area stays as you left it).",
  "life_potion":   { "name": "Life Potion",   "restore": "life",   "pctOfMax": 0.4, "seconds": 2.0, "cooldownSeconds": 0.5, "price": 30 },
  "energy_potion": { "name": "Energy Potion", "restore": "energy", "pctOfMax": 0.5, "seconds": 1.5, "cooldownSeconds": 0.5, "price": 30 },
