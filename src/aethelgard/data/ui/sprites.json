{
  "_comment": "How actors look (client only; the core never reads this). A look is a set of layers, one sprite sheet each (assets/sprites/<sheet>.json + .png); single-sheet monsters use one 'body' layer. layerOrder = drawing order per facing (art compass: map +x = E), from back to front; layers it does not name are drawn last. looks.player is the bare character; gear adds or replaces layers by item base id (equipped items, slot by slot); slotLayers limits what an item may draw from each equipment slot (a sword in the off hand draws nothing: the art has no off-hand weapons yet). looks.<monster type id> = that monster (bosses use their baseType); types without a look are drawn as placeholder circles. attack = animation of the attack (swing | shoot | cast). drawScale × rank sizeMult = size on screen. strideTiles = tiles walked per run cycle (feet do not slide at any speed). corpseSeconds = how long a dead monster stays on the floor (the last 1.5 s it fades). hitFlash = brightness added while in hit recovery or stunned. import = settings of tools/import_flare.py, which converts the Flare art (sheets drawn for 192×96 tiles, ours are 64×32, so scale 1/3; colors = palette size of the PNGs, 0 = full color).",
  "import": {
    "scale": 0.33333,
    "atlasWidth": 1024,
    "colors": 256,
    "anims": ["stance", "run", "swing", "block", "hit", "die", "cast", "shoot"],
    "sources": {
      "flare/male/": "mods/fantasycore/animations/avatar/male/",
      "flare/enemies/": "mods/fantasycore/animations/enemies/"
    },
    "sourceRoot": "mods/fantasycore/"
  },
  "slotLayers": { "mainhand": ["main"], "offhand": ["off"] },
  "strideTiles": 1.7,
  "corpseSeconds": 8,
  "hitFlash": 70,
  "layerOrder": {
    "SW": ["main", "feet", "legs", "hands", "chest", "off", "head"],
    "W":  ["main", "feet", "legs", "hands", "chest", "off", "head"],
    "NW": ["main", "feet", "legs", "hands", "chest", "off", "head"],
    "N":  ["feet", "legs", "hands", "chest", "off", "head", "main"],
    "NE": ["feet", "legs", "hands", "chest", "off", "head", "main"],
    "E":  ["feet", "legs", "hands", "chest", "off", "head", "main"],
    "SE": ["feet", "legs", "hands", "main", "chest", "head", "off"],
    "S":  ["main", "feet", "legs", "hands", "chest", "head", "off"]
  },
  "looks": {
    "player": {
      "layers": {
        "head": "flare/male/head_short",
        "chest": "flare/male/default_chest",
        "legs": "flare/male/default_legs",
        "feet": "flare/male/default_feet",
        "hands": "flare/male/default_hands"
      }
    },
    "skeleton":        { "layers": { "body": "flare/enemies/skeleton" } },
    "skeleton_archer": { "layers": { "body": "flare/enemies/skeleton_archer" }, "attack": "shoot" },
    "necromancer":     { "layers": { "body": "flare/enemies/skeleton_mage" }, "attack": "cast" },
    "zombie":          { "layers": { "body": "flare/enemies/zombie" } },
    "bandit": {
      "layers": {
        "head": "flare/male/leather_hood",
        "chest": "flare/male/leather_chest",
        "legs": "flare/male/leather_pants",
        "feet": "flare/male/leather_boots",
        "hands": "flare/male/cloth_gloves",
        "main": "flare/male/hand_axe"
      }
    },
    "bandit_spearman": {
      "layers": {
        "head": "flare/male/chain_coif",
        "chest": "flare/male/chain_cuirass",
        "legs": "flare/male/leather_pants",
        "feet": "flare/male/leather_boots",
        "hands": "flare/male/leather_gloves",
        "main": "flare/male/infantry_axe"
      }
    },
    "shaman": {
      "layers": {
        "head": "flare/male/mage_hood",
        "chest": "flare/male/mage_vest",
        "legs": "flare/male/mage_skirt",
        "feet": "flare/male/mage_boots",
        "hands": "flare/male/mage_sleeves",
        "main": "flare/male/rod"
      },
      "attack": "cast"
    }
  },
  "gear": {
    "long_dagger":     { "main": "flare/male/dagger" },
    "short_sword":     { "main": "flare/male/shortsword" },
    "gladius":         { "main": "flare/male/shortsword" },
    "sabre":           { "main": "flare/male/longsword" },
    "long_sword":      { "main": "flare/male/longsword" },
    "bastard_sword":   { "main": "flare/male/greatsword" },
    "buckler":         { "off": "flare/male/buckler" },
    "round_shield":    { "off": "flare/male/iron_buckler" },
    "kite_shield":     { "off": "flare/male/kite_shield" },
    "tower_shield":    { "off": "flare/male/shield" },
    "leather_armor":   { "chest": "flare/male/leather_chest", "legs": "flare/male/leather_pants" },
    "studded_leather": { "chest": "flare/male/leather_chest", "legs": "flare/male/leather_pants" },
    "chain_mail":      { "chest": "flare/male/chain_cuirass", "legs": "flare/male/chain_greaves" },
    "scale_mail":      { "chest": "flare/male/plate_cuirass", "legs": "flare/male/chain_greaves" },
    "plate_mail":      { "chest": "flare/male/plate_cuirass", "legs": "flare/male/plate_greaves" },
    "helm":            { "head": "flare/male/chain_coif" },
    "gloves":          { "hands": "flare/male/leather_gloves" },
    "boots":           { "feet": "flare/male/leather_boots" }
  }
}
