        "kind": "archive",
        "title": "Wolf monsters animated",
        "url": "https://opengameart.org/sites/default/files/wolfs.7z",
        "page": "https://opengameart.org/content/wolf-monsters-animated",
        "license": "CC-BY-SA 3.0",
        "credit": "Danimal (animation and sheets), Micket (base model, CC0) and p0ss (fur textures)",
        "sheets": {
          "wolf":       { "animation": ["wolf.txt", "*wolf*.txt", "animation*.txt", "*.txt"], "exclude": ["*alpha*", "*black*", "*white*"] },
          "alpha_wolf": { "animation": ["*alpha*.txt", "wolf.txt", "animation*.txt", "*.txt"], "image": ["*alpha*.png"] }
        }
      },
      "oga-boars/": {
        "kind": "archive",
        "title": "Boar enemies",
        "urls": ["https://opengameart.org/sites/default/files/boar_enemies_anim_def.7z", "https://opengameart.org/sites/default/files/boar_2.png"],
        "page": "https://opengameart.org/content/boar-enemies",
        "license": "CC-BY-SA 4.0",
        "credit": "Danimal (animation and sheets), Myname (boar model, CC-BY) and Clint Bellanger (goblin)",
        "sheets": {
          "boar": { "animation": ["boar.txt", "boar_2.txt", "*boar*.txt", "*.txt"], "image": ["boar_2.png", "boar.png"], "exclude": ["*rider*", "*knight*", "*shaman*", "*armor*"] }
        }
      }
    }
