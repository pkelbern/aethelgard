        "page": "https://github.com/flareteam/flare-game",
        "license": "CC-BY-SA 3.0",
        "credit": "Clint Bellanger, Justin Jacobs and the Flare contributors (CREDITS-flare-game.txt)",
        "licenseFiles": { "LICENSE.txt": "LICENSE-CC-BY-SA-3.0.txt", "CREDITS.txt": "CREDITS-flare-game.txt" },
        "imageRoot": "mods/fantasycore/",
        "folders": {
          "male/": "mods/fantasycore/animations/avatar/male/",
          "enemies/": "mods/fantasycore/animations/enemies/",
          "npcs/": "mods/fantasycore/animations/npcs/",
